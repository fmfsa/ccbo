{
  "suite": "mcbo",
  "seeds": [
    2000,
    2001,
    2002,
    2003,
    2004,
    2005,
    2006,
    2007,
    2008,
    2009,
    2010,
    2011,
    2012,
    2013,
    2014,
    2015,
    2016,
    2017,
    2018,
    2019
  ],
  "defaults": {
    "--num-trials": "100",
    "--score-samples": "100000"
  },
  "cases": [
    {
      "id": "ToyGraph-MCBO-full-seed{seed}",
      "options": {
        "--env": "ToyGraph",
        "--algo": "MCBO",
        "--menu": "full"
      }
    },
    {
      "id": "ToyGraph-MCBO-coarse-seed{seed}",
      "options": {
        "--env": "ToyGraph",
        "--algo": "MCBO",
        "--menu": "coarse"
      }
    },
    {
      "id": "ToyGraph-QMCBO-coarse-seed{seed}",
      "options": {
        "--env": "ToyGraph",
        "--algo": "QMCBO",
        "--menu": "coarse"
      }
    },
    {
      "id": "PSAGraph-MCBO-full-seed{seed}",
      "options": {
        "--env": "PSAGraph",
        "--algo": "MCBO",
        "--menu": "full"
      }
    },
    {
      "id": "PSAGraph-MCBO-coarse-seed{seed}",
      "options": {
        "--env": "PSAGraph",
        "--algo": "MCBO",
        "--menu": "coarse"
      }
    },
    {
      "id": "PSAGraph-QMCBO-coarse-seed{seed}",
      "options": {
        "--env": "PSAGraph",
        "--algo": "QMCBO",
        "--menu": "coarse"
      }
    },
    {
      "id": "ToyGraph-MCBO-full-seed{seed}-e2",
      "options": {
        "--env": "ToyGraph",
        "--algo": "MCBO",
        "--menu": "full",
        "--misspec": "del:0:1"
      }
    },
    {
      "id": "ToyGraph-QMCBO-coarse-seed{seed}-e2",
      "options": {
        "--env": "ToyGraph",
        "--algo": "QMCBO",
        "--menu": "coarse",
        "--misspec": "del:0:1"
      }
    },
    {
      "id": "PSAGraph-MCBO-full-seed{seed}-e2",
      "options": {
        "--env": "PSAGraph",
        "--algo": "MCBO",
        "--menu": "full",
        "--misspec": "add:2:3"
      }
    },
    {
      "id": "PSAGraph-QMCBO-coarse-seed{seed}-e2",
      "options": {
        "--env": "PSAGraph",
        "--algo": "QMCBO",
        "--menu": "coarse",
        "--misspec": "add:2:3"
      }
    }
  ]
}
