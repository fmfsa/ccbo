    },
    {
      "id": "nonstat_regularized-DCBO-native-seed{seed}",
      "options": {
        "--setup": "nonstat_regularized",
        "--algo": "DCBO",
        "--action-menu": "native"
      }
    },
    {
      "id": "nonstat_regularized-DCBO-coarse-seed{seed}",
      "options": {
        "--setup": "nonstat_regularized",
        "--algo": "DCBO",
        "--action-menu": "coarse"
      }
    },
    {
      "id": "nonstat_regularized-QDCBO-native-seed{seed}",
      "options": {
        "--setup": "nonstat_regularized",
        "--algo": "QDCBO",
        "--action-menu": "native"
      }
    }
  ]
