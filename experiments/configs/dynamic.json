  "cases": [
    {
      "id": "stat-DCBO-native-seed{seed}",
      "options": {
        "--setup": "stat",
        "--algo": "DCBO",
        "--action-menu": "native"
      }
    },
    {
      "id": "stat-DCBO-coarse-seed{seed}",
      "options": {
        "--setup": "stat",
        "--algo": "DCBO",
        "--action-menu": "coarse"
      }
    },
    {
      "id": "stat-QDCBO-native-seed{seed}",
      "options": {
        "--setup": "stat",
        "--algo": "QDCBO",
        "--action-menu": "native"
      }
    },
    {
      "id": "ind-DCBO-native-seed{seed}",
      "options": {
        "--setup": "ind",
        "--algo": "DCBO",
        "--action-menu": "native"
      }
    },
    {
      "id": "ind-DCBO-coarse-seed{seed}",
      "options": {
        "--setup": "ind",
        "--algo": "DCBO",
        "--action-menu": "coarse"
      }
    },
    {
      "id": "ind-QDCBO-native-seed{seed}",
      "options": {
        "--setup": "ind",
        "--algo": "QDCBO",
        "--action-menu": "native"
