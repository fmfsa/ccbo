#!/bin/bash
#BSUB -J ccbo_mcbo_launch_gate
#BSUB -q hpc
#BSUB -n 1
#BSUB -W 00:30
#BSUB -R "rusage[mem=2GB]"
#BSUB -o /zhome/15/b/215295/Repositories/ccbo-experiments-20260916/logs/mcbo_gate_%J.out
#BSUB -e /zhome/15/b/215295/Repositories/ccbo-experiments-20260916/logs/mcbo_gate_%J.err
set -euo pipefail
BASE=/zhome/15/b/215295/Repositories/ccbo-experiments-20260916
PYTHON=/zhome/15/b/215295/venvs/mcbo/bin/python
[[ ! -e "$BASE/results/mcbo-campaign-v3/STOP.json" ]] || { echo 'Persistent STOP; gate blocked' >&2; exit 2; }
# Preserve either successful or blocked strict audit in the submission record.
set -o noclobber
"$PYTHON" "$BASE/server-launch/check_mcbo_launch_gate.py" --release "$BASE/releases/mcbo-campaign-v3" --preflight-results "$BASE/results/mcbo-preflight" > "$BASE/launch-records/mcbo-campaign-v3/launch-gate.json" 2>&1
