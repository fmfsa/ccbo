#!/bin/bash
#BSUB -J ccbo_matched_final_analysis
#BSUB -q hpc
#BSUB -n 1
#BSUB -W 00:30
#BSUB -R "rusage[mem=6GB]"
#BSUB -o /zhome/15/b/215295/Repositories/ccbo-experiments-20260916/logs/matched_final_analysis_%J.out
#BSUB -e /zhome/15/b/215295/Repositories/ccbo-experiments-20260916/logs/matched_final_analysis_%J.err
set -euo pipefail
BASE=/zhome/15/b/215295/Repositories/ccbo-experiments-20260916
PYTHON=/zhome/15/b/215295/venvs/ccbo/bin/python
RELEASE="$BASE/releases/matched-preflight-v3"
CAMPAIGN=989629b3691bc2b0a015eff4beee55e5dbb24a287692401acf66f87605bc23d4
# Submission helper attaches numended(array_id, == 720), including EXIT failures.
"$PYTHON" "$BASE/server-launch/check_matched_launch_gate.py" --release "$RELEASE" --preflight-results "$BASE/results/matched-preflight" --diagnostic-results "$BASE/results/matched-hq-diagnostic"
cd "$RELEASE"
OUT="$BASE/analysis/$CAMPAIGN/final-audit-job-${LSB_JOBID:?Missing LSF job id}.json"
[[ ! -e "$OUT" ]] || { echo 'Refusing to overwrite analysis artifact' >&2; exit 2; }
"$PYTHON" "$BASE/server-launch/run_matched_final_analysis.py" --release "$RELEASE" --results "$BASE/results/matched-replication" --out "$OUT"
