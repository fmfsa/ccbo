set -euo pipefail
cd /zhome/15/b/215295/Repositories/ccbo-review-20260916-validation
export PYTHONPATH=. PYTHONDONTWRITEBYTECODE=1 PYTHONHASHSEED=0
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export MPLCONFIGDIR=/zhome/15/b/215295/Repositories/ccbo-review-20260916-validation/validation/mpl
mkdir -p validation
